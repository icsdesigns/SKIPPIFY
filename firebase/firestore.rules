rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/friend_groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/friend_groups/$(groupId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /listening_events/{eventId} {
        allow read, write: if isOwner(uid);
      }

      match /league_weekly_stats/{weekId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /friend_groups/{groupId} {
      // `get` NO puede ser más estricto que `list`: unirse a un grupo consulta
      // esta misma colección por `inviteCode`, así que cualquier usuario
      // autenticado ya recibe el documento entero. Exigir pertenencia sólo en
      // `get` no protegía nada y era la causa del «Firebase rechazó el acceso»
      // al abrir un grupo cuando la ficha de miembro no estaba (reinstalación,
      // datos borrados o uid anónimo nuevo).
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        // Leer la lista de miembros sigue exigiendo pertenecer al grupo, pero
        // sin `exists()` sobre uno mismo: un miembro se ve siempre su ficha, y
        // eso es lo que permite repararla cuando se ha perdido.
        allow read: if isOwner(uid) || isGroupMember(groupId);
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid) || isGroupOwner(groupId);
      }

      // Registros de funcionalidad (modo con servidor): cada miembro escribe SOLO
      // lo suyo (el documento con id = su uid) y los miembros del grupo leen.
      // El documento lleva la versión de la app en claro (`appVersion`, visible
      // para todo el grupo, se comparta o no el registro) y los datos del
      // registro, si se comparte, van comprimidos en `chunks/{n}`: Firestore
      // limita cada documento a ~1 MiB, así que cada trozo lleva como mucho
      // ~700 KB de texto. La clave de descarga de la interfaz NO se aplica aquí:
      // es una puerta de interfaz, no una regla de acceso.
      match /functionality_logs/{uid} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isOwner(uid) && isGroupMember(groupId) &&
          request.resource.data.appVersion is string &&
          request.resource.data.appVersion.size() <= 40;
        allow delete: if isOwner(uid) && isGroupMember(groupId);

        match /chunks/{chunkId} {
          allow read: if isGroupMember(groupId);
          allow create, update: if isOwner(uid) && isGroupMember(groupId) &&
            request.resource.data.keys().hasOnly(['z', 'i', 'n', 'rows', 'uploadedAt']) &&
            request.resource.data.z is string &&
            request.resource.data.z.size() <= 700000;
          allow delete: if isOwner(uid) && isGroupMember(groupId);
        }
      }

      // El ranking sí es dato compartido y se queda tras la pertenencia. La app
      // rehace la ficha de miembro y reintenta si aquí recibe permission-denied.
      match /weekly_results/{weekId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }
    }
  }
}
