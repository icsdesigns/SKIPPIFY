<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget «Modo de escucha». Cada bloque va en su tarjeta: las dos cifras del
  día arriba y el selector de modo abajo, como un control segmentado. Las
  cifras y qué botón está activo los pone WidgetsSkippify.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_modo_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_modo_cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_skippify" />

        <TextView
            style="@style/SkippifyWidgetTitulo"
            android:text="Modo de escucha" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/SkippifyWidgetTarjeta">

            <TextView
                style="@style/SkippifyWidgetRotulo"
                android:text="Duplicadas hoy" />

            <TextView
                android:id="@+id/widget_modo_duplicadas"
                style="@style/SkippifyWidgetCifra"
                android:text="0" />
        </LinearLayout>

        <LinearLayout
            style="@style/SkippifyWidgetTarjeta"
            android:layout_marginStart="8dp">

            <TextView
                style="@style/SkippifyWidgetRotulo"
                android:text="Saltadas hoy" />

            <TextView
                android:id="@+id/widget_modo_saltadas"
                style="@style/SkippifyWidgetCifra"
                android:text="0"
                android:textColor="#FF1ED760" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_segmentos"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/widget_modo_descubrimiento"
            style="@style/SkippifyWidgetModo"
            android:layout_weight="1.3"
            android:text="Descubrimiento" />

        <TextView
            android:id="@+id/widget_modo_casual"
            style="@style/SkippifyWidgetModo"
            android:layout_weight="1"
            android:text="Casual" />

        <TextView
            android:id="@+id/widget_modo_personalizado"
            style="@style/SkippifyWidgetModo"
            android:layout_weight="1.2"
            android:text="Personalizado" />
    </LinearLayout>
</LinearLayout>
