<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Tu semana». Las cifras, el gráfico y el día de hoy los pone WidgetsSkippify. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_semana_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_skippify" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Tu semana"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_semana_rango"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFB3B3B3"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_semana_escuchas"
                style="@style/SkippifyWidgetCifra"
                android:text="0"
                android:textColor="#FFFFFFFF" />

            <TextView
                style="@style/SkippifyWidgetEtiqueta"
                android:text="escuchas" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_semana_tiempo"
                style="@style/SkippifyWidgetCifra"
                android:text="0 min"
                android:textColor="#FFFFFFFF" />

            <TextView
                style="@style/SkippifyWidgetEtiqueta"
                android:text="escuchado" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_semana_media"
                style="@style/SkippifyWidgetCifra"
                android:text="0 min"
                android:textColor="#FFFFFFFF" />

            <TextView
                style="@style/SkippifyWidgetEtiqueta"
                android:text="al día" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_semana_saltadas"
                style="@style/SkippifyWidgetCifra"
                android:text="0"
                android:textColor="#FF1ED760" />

            <TextView
                style="@style/SkippifyWidgetEtiqueta"
                android:text="saltadas" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_semana_barras"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:contentDescription="Escuchas por día"
        android:minHeight="28dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/widget_semana_d0" style="@style/SkippifyWidgetDia" android:text="L" />
        <TextView android:id="@+id/widget_semana_d1" style="@style/SkippifyWidgetDia" android:text="M" />
        <TextView android:id="@+id/widget_semana_d2" style="@style/SkippifyWidgetDia" android:text="X" />
        <TextView android:id="@+id/widget_semana_d3" style="@style/SkippifyWidgetDia" android:text="J" />
        <TextView android:id="@+id/widget_semana_d4" style="@style/SkippifyWidgetDia" android:text="V" />
        <TextView android:id="@+id/widget_semana_d5" style="@style/SkippifyWidgetDia" android:text="S" />
        <TextView android:id="@+id/widget_semana_d6" style="@style/SkippifyWidgetDia" android:text="D" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_semana_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Aún no hay escuchas esta semana"
        android:textColor="#FFB3B3B3"
        android:textSize="12sp" />
</LinearLayout>
