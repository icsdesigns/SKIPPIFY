<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget «Tu mes» (3×2): medias diarias de los últimos 30 días, cada una en su
  tarjeta con su icono. La pastilla de la cabecera dice entre cuántos días se
  reparte. Las cifras las pone WidgetsSkippify.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_semana_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_skippify" />

        <TextView
            style="@style/SkippifyWidgetTitulo"
            android:text="Tu mes" />

        <TextView
            android:id="@+id/widget_semana_rango"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="Media · 30 días"
            android:textColor="#FFE4E4E4"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:minHeight="50dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/SkippifyWidgetTarjeta">

            <LinearLayout style="@style/SkippifyWidgetRotuloFila">

                <ImageView
                    style="@style/SkippifyWidgetIcono"
                    android:src="@drawable/ic_widget_escuchas" />

                <TextView
                    style="@style/SkippifyWidgetRotuloIcono"
                    android:text="Escuchas" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_semana_escuchas"
                style="@style/SkippifyWidgetCifra"
                android:text="0" />
        </LinearLayout>

        <LinearLayout
            style="@style/SkippifyWidgetTarjeta"
            android:layout_marginStart="6dp"
            android:layout_weight="1.25">

            <LinearLayout style="@style/SkippifyWidgetRotuloFila">

                <ImageView
                    style="@style/SkippifyWidgetIcono"
                    android:src="@drawable/ic_widget_tiempo" />

                <TextView
                    style="@style/SkippifyWidgetRotuloIcono"
                    android:text="Tiempo" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_semana_tiempo"
                style="@style/SkippifyWidgetCifra"
                android:text="0 min" />
        </LinearLayout>

        <LinearLayout
            style="@style/SkippifyWidgetTarjeta"
            android:layout_marginStart="6dp">

            <LinearLayout style="@style/SkippifyWidgetRotuloFila">

                <ImageView
                    style="@style/SkippifyWidgetIcono"
                    android:src="@drawable/ic_widget_saltadas" />

                <TextView
                    style="@style/SkippifyWidgetRotuloIcono"
                    android:text="Saltadas" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_semana_saltadas"
                style="@style/SkippifyWidgetCifra"
                android:text="0"
                android:textColor="#FF1ED760" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
